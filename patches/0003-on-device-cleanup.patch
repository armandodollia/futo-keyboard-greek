@@ -0,0 +1,36 @@
+# libllmcleanup.so: on-device dictation cleanup (modern llama.cpp, CPU). Built only when llama.cpp has been fetched
+# into native/llmcleanup/llama.cpp (the build workflow pins and clones it) and only for 64-bit ABIs.
+cmake_minimum_required(VERSION 3.22)
+
+if(NOT ANDROID_ABI STREQUAL "arm64-v8a" AND NOT ANDROID_ABI STREQUAL "x86_64")
+    message(STATUS "llmcleanup: skipped for ${ANDROID_ABI}")
+    return()
+endif()
+
+set(LLAMA_DIR ${CMAKE_CURRENT_LIST_DIR}/llama.cpp)
+set(BUILD_SHARED_LIBS OFF CACHE BOOL "" FORCE)
+set(LLAMA_BUILD_COMMON OFF CACHE BOOL "" FORCE)
+set(LLAMA_BUILD_TESTS OFF CACHE BOOL "" FORCE)
+set(LLAMA_BUILD_TOOLS OFF CACHE BOOL "" FORCE)
+set(LLAMA_BUILD_EXAMPLES OFF CACHE BOOL "" FORCE)
+set(LLAMA_BUILD_SERVER OFF CACHE BOOL "" FORCE)
+set(LLAMA_CURL OFF CACHE BOOL "" FORCE)
+set(GGML_OPENMP OFF CACHE BOOL "" FORCE)
+set(GGML_NATIVE OFF CACHE BOOL "" FORCE)
+set(GGML_LLAMAFILE OFF CACHE BOOL "" FORCE)
+if(ANDROID_ABI STREQUAL "arm64-v8a")
+    # dotprod: every phone since ~2019; the Q4_0 fast paths repack weights for it at load time
+    set(GGML_CPU_ARM_ARCH "armv8.2-a+dotprod+fp16" CACHE STRING "" FORCE)
+endif()
+
+# hide everything inside the static llama/ggml libraries: no symbol clashes with FUTO's own ggml
+set(CMAKE_C_VISIBILITY_PRESET hidden)
+set(CMAKE_CXX_VISIBILITY_PRESET hidden)
+set(CMAKE_VISIBILITY_INLINES_HIDDEN ON)
+set(CMAKE_POSITION_INDEPENDENT_CODE ON)
+add_subdirectory(${LLAMA_DIR} ${CMAKE_CURRENT_BINARY_DIR}/llama.cpp EXCLUDE_FROM_ALL)
+
+add_library(llmcleanup SHARED ${CMAKE_CURRENT_LIST_DIR}/llmcleanup_jni.cpp)
+target_link_libraries(llmcleanup PRIVATE llama ggml log)
+target_link_options(llmcleanup PRIVATE -Wl,--exclude-libs,ALL -Wl,--gc-sections -Wl,-z,max-page-size=16384
+    -Wl,--version-script=${CMAKE_CURRENT_LIST_DIR}/exports.map)
