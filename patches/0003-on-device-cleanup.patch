+++ b/java/src/org/futo/inputmethod/latin/uix/cleanup/LocalLlm.kt
@@ -0,0 +1,102 @@
+package org.futo.inputmethod.latin.uix.cleanup
+
+import android.content.Context
+import android.net.Uri
+import android.util.Log
+import kotlinx.coroutines.CoroutineDispatcher
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.asCoroutineDispatcher
+import kotlinx.coroutines.withContext
+import java.io.File
+import java.util.concurrent.Executors
+
+/**
+ * On-device dictation cleanup: a fine-tuned small model (GGUF, e.g. Qwen3-1.7B Q4_0) run by libllmcleanup.so
+ * (modern llama.cpp, CPU). The model file lives in filesDir/cleanup-models/cleanup.gguf, imported from settings.
+ */
+object LocalLlm {
+    private const val TAG = "LocalLlm"
+    private val available: Boolean = try {
+        System.loadLibrary("llmcleanup"); true
+    } catch (e: Throwable) {
+        Log.w(TAG, "libllmcleanup not available on this device/ABI: ${e.message}"); false
+    }
+
+    @JvmStatic private external fun nativeLoad(path: String, threads: Int): Long
+    @JvmStatic private external fun nativeGenerate(handle: Long, prompt: String, maxTokens: Int): String?
+    @JvmStatic private external fun nativeFree(handle: Long)
+
+    /** All native calls run on one background thread, so the model is never used concurrently. */
+    private val thread: CoroutineDispatcher = Executors.newSingleThreadExecutor { r ->
+        Thread(r, "llm-cleanup").apply { priority = Thread.NORM_PRIORITY - 1 }
+    }.asCoroutineDispatcher()
+    private var handle = 0L
+    private var loadedPath: String? = null
+
+    fun modelFile(context: Context) = File(File(context.filesDir, "cleanup-models"), "cleanup.gguf")
+    fun isSupported() = available
+    fun hasModel(context: Context) = modelFile(context).let { it.exists() && it.length() > 0 }
+
+    suspend fun import(context: Context, uri: Uri): Result<Long> = withContext(Dispatchers.IO) {
+        runCatching {
+            val dst = modelFile(context); dst.parentFile?.mkdirs()
+            val tmp = File(dst.parentFile, "cleanup.gguf.part")
+            context.contentResolver.openInputStream(uri)!!.use { input ->
+                val magic = ByteArray(4); input.read(magic)
+                require(String(magic, Charsets.US_ASCII) == "GGUF") { "not a GGUF model file" }
+                tmp.outputStream().use { it.write(magic); input.copyTo(it, 1 shl 20) }
+            }
+            release()
+            if (!tmp.renameTo(dst)) { dst.delete(); tmp.renameTo(dst) }
+            dst.length()
+        }
+    }
+
+    suspend fun remove(context: Context) { release(); withContext(Dispatchers.IO) { modelFile(context).delete() } }
+
+    suspend fun release() = withContext(thread) {
+        if (handle != 0L) { nativeFree(handle); handle = 0L; loadedPath = null }
+    }
+
+    /** Loads the model on first use (about a second), then keeps it resident while the keyboard process lives. */
+    suspend fun generate(context: Context, prompt: String, maxTokens: Int): String = withContext(thread) {
+        check(available) { "on-device runtime not available" }
+        val f = modelFile(context)
+        check(f.exists()) { "no on-device model imported" }
+        if (handle == 0L || loadedPath != f.path) {
+            if (handle != 0L) nativeFree(handle)
+            val threads = Runtime.getRuntime().availableProcessors().coerceIn(2, 4)
+            handle = nativeLoad(f.path, threads)
+            check(handle != 0L) { "could not load ${f.name}" }
+            loadedPath = f.path
+        }
+        nativeGenerate(handle, prompt, maxTokens) ?: error("generation failed")
+    }
+}
+
+/** CleanupBackend for the on-device model, using the exact prompt format the model was fine-tuned with. */
+class LocalCleanupModel(private val context: Context) : CleanupBackend {
+    override val name = "local"
+
+    private fun systemPrompt(mode: String, language: String?): String {
+        val lang = when (language) { "el" -> "Greek"; "sq" -> "Albanian"; else -> "English" }
+        val task = if (mode == CleanupMode.RAMBLER) "Rewrite as a short, clear message"
+        else "Clean up: punctuation, capitals, remove fillers, apply self-corrections, keep the words"
+        return "$task. Language: $lang. Never translate. Keep slang and swearing exactly. Output only the text."
+    }
+
+    override suspend fun clean(text: String, mode: String, language: String?): String {
+        val prompt = "<|im_start|>system\n${systemPrompt(mode, language)}<|im_end|>\n" +
+            "<|im_start|>user\n$text<|im_end|>\n<|im_start|>assistant\n<think>\n\n</think>\n\n"
+        return LocalLlm.generate(context, prompt, (text.length * 0.8).toInt() + 40).trim()
+    }
+
+    companion object {
+        /** Registers the on-device backend when a model is present (called before each cleanup). */
+        fun ensureRegistered(context: Context) {
+            val ok = LocalLlm.isSupported() && LocalLlm.hasModel(context)
+            if (ok && LocalCleanupBackend.backend == null) LocalCleanupBackend.backend = LocalCleanupModel(context.applicationContext)
+            if (!ok) LocalCleanupBackend.backend = null
+        }
+    }
+}
