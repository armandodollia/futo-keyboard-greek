--- /dev/null
+++ b/native/llmcleanup/llmcleanup_jni.cpp
@@ -0,0 +1,121 @@
+// On-device dictation cleanup: a small, separate JNI library around a modern llama.cpp (pinned, fetched at build time).
+// Built with hidden symbols so it never clashes with the older ggml/llama.cpp inside libjni_latinime.so.
+// API (org.futo.inputmethod.latin.uix.cleanup.LocalLlm):
+//   nativeLoad(path, threads) -> handle (0 on failure)
+//   nativeGenerate(handle, prompt, maxTokens) -> text (greedy, stops at end-of-generation), or null on failure
+//   nativeFree(handle)
+#include <jni.h>
+#include <android/log.h>
+
+#include <mutex>
+#include <string>
+#include <vector>
+
+#include "llama.h"
+
+#define TAG "llmcleanup"
+#define LOGI(...) __android_log_print(ANDROID_LOG_INFO, TAG, __VA_ARGS__)
+#define LOGE(...) __android_log_print(ANDROID_LOG_ERROR, TAG, __VA_ARGS__)
+
+namespace {
+
+struct Session {
+    llama_model * model = nullptr;
+    llama_context * ctx = nullptr;
+    std::mutex lock;
+};
+
+std::once_flag g_backend_once;
+
+std::string jstr(JNIEnv * env, jstring s) {
+    if (!s) return {};
+    const char * c = env->GetStringUTFChars(s, nullptr);
+    std::string out(c);
+    env->ReleaseStringUTFChars(s, c);
+    return out;
+}
+
+// Java's NewStringUTF wants modified UTF-8; build the string from UTF-16 to be safe with any model output.
+jstring to_jstring(JNIEnv * env, const std::string & s) {
+    std::u16string u16;
+    for (size_t i = 0; i < s.size();) {
+        unsigned char c = s[i];
+        uint32_t cp; int n;
+        if (c < 0x80) { cp = c; n = 1; }
+        else if ((c >> 5) == 0x6) { cp = c & 0x1F; n = 2; }
+        else if ((c >> 4) == 0xE) { cp = c & 0x0F; n = 3; }
+        else if ((c >> 3) == 0x1E) { cp = c & 0x07; n = 4; }
+        else { i++; continue; }
+        if (i + n > s.size()) break;
+        for (int k = 1; k < n; k++) cp = (cp << 6) | (s[i + k] & 0x3F);
+        i += n;
+        if (cp >= 0x10000) { cp -= 0x10000; u16 += (char16_t)(0xD800 + (cp >> 10)); u16 += (char16_t)(0xDC00 + (cp & 0x3FF)); }
+        else u16 += (char16_t)cp;
+    }
+    return env->NewString(reinterpret_cast<const jchar *>(u16.data()), (jsize)u16.size());
+}
+
+}  // namespace
+
+extern "C" JNIEXPORT jlong JNICALL
+Java_org_futo_inputmethod_latin_uix_cleanup_LocalLlm_nativeLoad(JNIEnv * env, jclass, jstring jpath, jint threads) {
+    std::call_once(g_backend_once, [] { llama_backend_init(); });
+    std::string path = jstr(env, jpath);
+    llama_model_params mp = llama_model_default_params();
+    mp.n_gpu_layers = 0;
+    llama_model * model = llama_model_load_from_file(path.c_str(), mp);
+    if (!model) { LOGE("failed to load %s", path.c_str()); return 0; }
+    llama_context_params cp = llama_context_default_params();
+    cp.n_ctx = 1024;
+    cp.n_batch = 512;
+    cp.n_threads = threads;
+    cp.n_threads_batch = threads;
+    llama_context * ctx = llama_init_from_model(model, cp);
+    if (!ctx) { LOGE("failed to create context"); llama_model_free(model); return 0; }
+    auto * s = new Session();
+    s->model = model; s->ctx = ctx;
+    LOGI("loaded %s (%d threads)", path.c_str(), threads);
+    return reinterpret_cast<jlong>(s);
+}
+
+extern "C" JNIEXPORT jstring JNICALL
+Java_org_futo_inputmethod_latin_uix_cleanup_LocalLlm_nativeGenerate(JNIEnv * env, jclass, jlong handle, jstring jprompt, jint max_tokens) {
+    auto * s = reinterpret_cast<Session *>(handle);
+    if (!s) return nullptr;
+    std::lock_guard<std::mutex> guard(s->lock);
+    const llama_vocab * vocab = llama_model_get_vocab(s->model);
+    std::string prompt = jstr(env, jprompt);
+
+    int n = -llama_tokenize(vocab, prompt.c_str(), (int32_t)prompt.size(), nullptr, 0, true, true);
+    std::vector<llama_token> toks(n);
+    if (llama_tokenize(vocab, prompt.c_str(), (int32_t)prompt.size(), toks.data(), n, true, true) < 0) return nullptr;
+    if ((int)toks.size() + max_tokens > (int)llama_n_ctx(s->ctx)) { LOGE("prompt too long (%d tokens)", (int)toks.size()); return nullptr; }
+
+    llama_memory_clear(llama_get_memory(s->ctx), true);
+    // prompt in chunks of n_batch
+    for (size_t i = 0; i < toks.size(); i += 512) {
+        int32_t len = (int32_t)std::min<size_t>(512, toks.size() - i);
+        if (llama_decode(s->ctx, llama_batch_get_one(toks.data() + i, len)) != 0) { LOGE("prompt decode failed"); return nullptr; }
+    }
+    llama_sampler * smpl = llama_sampler_chain_init(llama_sampler_chain_default_params());
+    llama_sampler_chain_add(smpl, llama_sampler_init_greedy());
+    std::string out;
+    char buf[256];
+    for (int i = 0; i < max_tokens; i++) {
+        llama_token t = llama_sampler_sample(smpl, s->ctx, -1);
+        if (llama_vocab_is_eog(vocab, t)) break;
+        int k = llama_token_to_piece(vocab, t, buf, sizeof(buf), 0, false);
+        if (k > 0) out.append(buf, k);
+        if (llama_decode(s->ctx, llama_batch_get_one(&t, 1)) != 0) { LOGE("decode failed"); break; }
+    }
+    llama_sampler_free(smpl);
+    return to_jstring(env, out);
+}
+
+extern "C" JNIEXPORT void JNICALL
+Java_org_futo_inputmethod_latin_uix_cleanup_LocalLlm_nativeFree(JNIEnv *, jclass, jlong handle) {
+    auto * s = reinterpret_cast<Session *>(handle);
+    if (!s) return;
+    { std::lock_guard<std::mutex> guard(s->lock); llama_free(s->ctx); llama_model_free(s->model); }
+    delete s;
+}
