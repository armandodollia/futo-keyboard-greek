+import org.futo.inputmethod.latin.uix.settings.SettingToggleDataStore
+import org.futo.inputmethod.latin.uix.settings.useDataStore
+
+private const val TEST_SAMPLE =
+    "εεε λοιπόν θα έρθω αύριο στις πέντε όχι συγγνώμη στις έξι και θα φέρω και τα γλυκά εντάξει"
+
+@Composable
+fun DictationCleanupScreen(navController: NavHostController = rememberNavController()) {
+    val context = LocalContext.current
+    val scope = rememberCoroutineScope()
+    val testOutput = remember { mutableStateOf("") }
+
+    ScrollableList {
+        ScreenTitle(stringResource(R.string.dictation_cleanup_title), showBack = true, navController)
+        SettingToggleDataStore(
+            title = stringResource(R.string.dictation_cleanup_title),
+            subtitle = stringResource(R.string.dictation_cleanup_subtitle),
+            setting = DICTATION_CLEANUP_ENABLED
+        )
+        SettingRadio(
+            title = "Mode",
+            options = listOf(CleanupMode.LIGHT, CleanupMode.RAMBLER),
+            optionNames = listOf("Light: punctuation, fillers, self-corrections", "Rambler: rewrite into a short, clear message"),
+            setting = useDataStore(DICTATION_CLEANUP_MODE)
+        )
+        SettingRadio(
+            title = "Where to run",
+            options = listOf(CleanupStrategy.RACE, CleanupStrategy.FASTEST, CleanupStrategy.REMOTE, CleanupStrategy.LOCAL),
+            optionNames = listOf(
+                "Remote + local in parallel, prefer remote",
+                "Remote + local in parallel, fastest wins",
+                "Remote only",
+                "Local only"
+            ),
+            setting = useDataStore(DICTATION_CLEANUP_STRATEGY)
+        )
+        SettingTextField("Remote server URL", "http://100.x.y.z:8080  (OpenAI-compatible)", DICTATION_CLEANUP_REMOTE_URL)
+        SettingTextField("API key (optional)", "leave blank for a trusted tailnet", DICTATION_CLEANUP_REMOTE_KEY)
+        SettingTextField("Model name (optional)", "e.g. home", DICTATION_CLEANUP_REMOTE_MODEL)
+        SettingRadio(
+            title = "Remote timeout",
+            options = listOf(2000, 4000, 8000),
+            optionNames = listOf("2 seconds", "4 seconds", "8 seconds"),
+            setting = useDataStore(DICTATION_CLEANUP_REMOTE_TIMEOUT_MS)
+        )
+
+        ScreenTitle("Local model")
+        Text(
+            if (LocalCleanupBackend.backend != null) "On-device model loaded (${LocalCleanupBackend.backend!!.name})"
+            else "No on-device model installed yet: local and parallel modes use the remote server only, and the raw transcript is kept if it fails.",
+            modifier = Modifier.padding(16.dp, 4.dp), style = MaterialTheme.typography.bodyMedium
+        )
+
+        ScreenTitle("Test")
+        Button(onClick = {
+            testOutput.value = "running…"
+            scope.launch {
+                val r = DictationCleanup.clean(context, TEST_SAMPLE, "el")
+                testOutput.value = "source: ${r.source}, ${r.millis} ms\n${r.text}" +
+                    (if (r.errors.isNotEmpty()) "\n\n" + r.errors.joinToString("\n") else "")
+            }
+        }, modifier = Modifier.fillMaxWidth().padding(16.dp, 4.dp)) { Text("Test with a Greek sample") }
+        if (testOutput.value.isNotEmpty()) {
+            Text(testOutput.value, modifier = Modifier.padding(16.dp, 8.dp), style = MaterialTheme.typography.bodyMedium)
+        }
+        BottomSpacer()
+    }
+}
