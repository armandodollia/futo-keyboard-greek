+static std::vector<uint32_t> safe_codepoints_from_utf8(const std::string &utf8) {
+    std::vector<uint32_t> result;
+    size_t i = 0, len = utf8.size();
+    while (i < len) {
+        uint8_t c = (uint8_t)utf8[i];
+        int n = c < 0x80 ? 0 : (c & 0xE0) == 0xC0 ? 1 : (c & 0xF0) == 0xE0 ? 2 : (c & 0xF8) == 0xF0 ? 3 : -1;
+        if (n < 0 || i + n >= len) { i += 1; continue; }  // invalid lead byte or truncated sequence
+        uint32_t cp = n == 0 ? c : n == 1 ? (c & 0x1F) : n == 2 ? (c & 0x0F) : (c & 0x07);
+        bool ok = true;
+        for (int k = 1; k <= n; k++) {
+            uint8_t cc = (uint8_t)utf8[i + k];
+            if ((cc & 0xC0) != 0x80) { ok = false; break; }
+            cp = (cp << 6) | (cc & 0x3F);
+        }
+        if (!ok) { i += 1; continue; }
+        result.push_back(cp);
+        i += n + 1;
+    }
+    return result;
