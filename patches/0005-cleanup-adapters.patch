+private fun installedVersion(value: String, entry: ModelEntry): Int? =
+    value.split("@").takeIf { it.size == 3 && it[0] == entry.id }?.get(1)?.toIntOrNull()
+
+/**
+ * Per-language cleanup models: one shared base (kind "cleanup-base") plus a small LoRA adapter per language
+ * (kind "cleanup-adapter"). Each row downloads whichever of the two is missing or outdated.
+ */
+@Composable
+fun CleanupAdapterDownloads(enabled: Boolean, onInstalled: () -> Unit) {
+    val context = LocalContext.current
+    LaunchedEffect(Unit) { ModelDownloads.refreshIndex(context) }
+    val base = ModelDownloads.entries.firstOrNull { it.kind == ModelDownloads.KIND_CLEANUP_BASE } ?: return
+    val adapters = ModelDownloads.entries.filter { it.kind == ModelDownloads.KIND_CLEANUP_ADAPTER }
+    if (adapters.isEmpty()) return
+    val baseSlot = ModelDownloads.slot(base, "")
+    val baseValue = useDataStore(ModelDownloads.installedKey(baseSlot), "").value
+    LaunchedEffect(baseValue) { onInstalled() }
+    val basePresent = LocalLlm.baseFile(context).exists()
+    val baseCurrent = basePresent && (installedVersion(baseValue, base) ?: 0) >= base.version
+
+    Text(
+        stringResource(R.string.model_downloads_cleanup_per_language_explainer),
+        modifier = Modifier.padding(start = 16.dp, end = 16.dp, top = 12.dp, bottom = 4.dp),
+        style = Typography.Small
+    )
+    adapters.forEach { CleanupAdapterRow(base, basePresent, baseCurrent, it, enabled, onInstalled) }
+    ModelDownloads.tasks[baseSlot]?.let { DownloadProgress(baseSlot, it) }
+}
+
+@Composable
+private fun CleanupAdapterRow(
+    base: ModelEntry, basePresent: Boolean, baseCurrent: Boolean, adapter: ModelEntry, enabled: Boolean, onInstalled: () -> Unit
+) {
+    val context = LocalContext.current
+    val slot = ModelDownloads.slot(adapter, "")
+    val value = useDataStore(ModelDownloads.installedKey(slot), "").value
+    LaunchedEffect(value) { onInstalled() }
+    val present = LocalLlm.adapterFile(context, adapter.locale).exists()
+    val adapterCurrent = present && (installedVersion(value, adapter) ?: 0) >= adapter.version
+    val need = listOfNotNull(base.takeIf { !baseCurrent }, adapter.takeIf { !adapterCurrent })
+    val needBytes = need.sumOf { it.variants[it.defaultVariant].size }
+    // "Update" when everything still needed is already installed in an older version
+    val update = need.isNotEmpty() && need.all { if (it === base) basePresent else present }
+    val languageName = CleanupPrompts.languageName(adapter.locale) ?: adapter.locale
+    val task = ModelDownloads.tasks[slot]
+    var confirm by remember { mutableStateOf<Boolean?>(null) }
+
+    confirm?.let { metered ->
+        ConfirmDownloadDialog(adapter, ModelVariant("", needBytes, "", ""), metered,
+            onConfirm = { confirm = null; need.forEach { ModelDownloads.start(context, it, it.variants[it.defaultVariant], "") } },
+            onDismiss = { confirm = null })
+    }
+    Row(Modifier.padding(start = 16.dp, end = 6.dp, top = 4.dp), verticalAlignment = Alignment.CenterVertically) {
+        Column(Modifier.weight(1f)) {
+            Text(
+                stringResource(R.string.model_downloads_cleanup_per_language_row,
+                    formatModelSize(base.variants[base.defaultVariant].size), languageName,
+                    formatModelSize(adapter.variants[adapter.defaultVariant].size)),
+                style = Typography.Body.RegularMl
+            )
+            Text(
+                when {
+                    need.isEmpty() -> stringResource(R.string.model_downloads_cleanup_per_language_in_use, languageName)
+                    update -> stringResource(R.string.model_downloads_update_available)
+                    else -> stringResource(R.string.model_downloads_cleanup_per_language_missing, formatModelSize(needBytes))
+                },
+                style = Typography.Small,
+                color = if (need.isEmpty()) MaterialTheme.colorScheme.primary else Color.Unspecified
+            )
+        }
+        if (need.isNotEmpty() && (task == null || task.error != null)) {
+            TextButton(onClick = { confirm = ModelDownloads.isMetered(context) }, enabled = enabled) {
+                Text(stringResource(if (update) R.string.model_downloads_update else R.string.model_downloads_download))
+            }
+        }
+    }
+    task?.let { DownloadProgress(slot, it) }
+}
