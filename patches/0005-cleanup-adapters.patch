+extern "C" JNIEXPORT jboolean JNICALL
+Java_org_futo_inputmethod_latin_uix_cleanup_LocalLlm_nativeSetAdapter(JNIEnv * env, jclass, jlong handle, jstring jpath) {
+    auto * s = reinterpret_cast<Session *>(handle);
+    if (!s) return JNI_FALSE;
+    std::lock_guard<std::mutex> guard(s->lock);
+    std::string path = jstr(env, jpath);
+    if (path == s->active) return JNI_TRUE;
+    llama_adapter_lora * adapter = nullptr;
+    if (!path.empty()) {
+        auto it = s->adapters.find(path);
+        if (it != s->adapters.end()) {
+            adapter = it->second;
+        } else {
+            adapter = llama_adapter_lora_init(s->model, path.c_str());
+            if (!adapter) { LOGE("failed to load adapter %s", path.c_str()); return JNI_FALSE; }
+            s->adapters[path] = adapter;
+            LOGI("loaded adapter %s", path.c_str());
+        }
+    }
+    float scale = 1.0f;
+    if (llama_set_adapters_lora(s->ctx, adapter ? &adapter : nullptr, adapter ? 1 : 0, adapter ? &scale : nullptr) != 0) {
+        LOGE("failed to set adapter %s", path.c_str());
+        return JNI_FALSE;
+    }
+    llama_memory_clear(llama_get_memory(s->ctx), true);
+    s->active = path;
+    return JNI_TRUE;
+}
