{
  "locale": "sq",
  "description": "Shqip (Albanian incl. Gheg + slang)",
  "version": 1,
  "word_regex": "(?<![\\w'])[a-zA-ZëËçÇ]+(?:['’][a-zA-ZëËçÇ]+)?(?![\\w])",
  "sources": [
    {"path": "fineweb2.clean.txt", "boost": 1},
    {"path": "wikipedia.clean.txt", "boost": 1},
    {"path": "subtitles.clean.txt", "boost": 8},
    {"path": "gheg.clean.txt", "boost": 40},
    {"path": "offensive.clean.txt", "boost": 60},
    {"path": "spontaneous-speech/*.jsonl", "boost": 40, "field": "text"},
    {"path": "slang.txt", "boost": 200}
  ],
  "min_count": 24,
  "min_count_capitalised": 400,
  "capitalised_share": 0.9,
  "single_letters": "eaoiu",
  "all_caps": "titlecase",
  "drop_regex": "['’]s$",
  "min_f": 30,
  "core_min_f": 150,
  "max_f": 250,
  "core_words": [
    "qij", "qifsha", "qifshi", "qifsh", "t'qifsha", "ta", "qirje", "qire", "qirja", "qim", "pidh", "pidhi", "pidhin",
    "pidha", "kar", "kari", "karin", "karit", "karash", "mut", "muti", "mutin", "mutit", "kurvë", "kurva", "kurvën",
    "kurvat", "kurvave", "lavire", "lavirja", "rrot", "rrotin", "budalla", "budallai", "budallain", "budallë",
    "budallallëk", "kopil", "kopili", "kopilin", "bythë", "bytha", "bythën", "bythqirë", "bythqir", "pordhac", "pordhë",
    "gomar", "gomari", "lopë", "kretin", "kretini", "idiot", "idioti", "maskara", "maskarai", "qen", "qeni", "qenin",
    "dreq", "dreqi", "dreqin", "djall", "djalli", "trap", "trapi", "fshatar", "hajvan", "hajvani", "vlla", "vëlla",
    "motër", "çka", "qysh", "osht", "âsht", "ashtu", "tash", "ktu", "aty", "kqyr", "hajt", "hajde", "s'ka", "nuk", "ka",
    "kom", "jom", "jena", "jeni", "janë", "me", "bo", "ba", "punu", "shku", "ardh", "hangër", "pi", "hiç", "kurgjo",
    "kurrgjë", "gjithçka", "diçka", "çfarë", "ça", "çar", "çdo", "kanë", "kena", "ke", "ki", "shpi", "shpija", "fmija",
    "fmijë", "kalamaj", "kalamajt", "burrë", "gru", "grua", "ok", "okej", "lol", "haha", "ckemi", "ç'kemi", "si", "je",
    "mirë", "faleminderit", "flm", "rrofsh", "tungjatjeta"
  ],
  "offensive_stems": ["qifsh", "qirje", "qirja", "qire", "pidh", "kurv", "lavir", "kopil", "bythqir", "pordh", "rrotk"],
  "offensive_exact": ["qij", "qimnane", "qijnë", "qiu", "kar", "kari", "karin", "karit", "karash", "mut", "muti", "mutin",
                      "mutit", "rrot", "rrotin", "bytha", "bythën", "byth", "t'qifsha"],
  "not_offensive_stems": ["kopilot", "kurvelesh", "qirjak", "lavirint"],
  "not_offensive_exact": [],
  "capitalised_offensive_stems": ["t'qifsh", "bythqir"],
  "extra_wordlist": null,
  "look": ["qifsha", "pidh", "kurvë", "budalla", "vlla", "osht", "qysh", "çka", "shqip", "përshëndetje", "Tirana", "kretin"],
  "notes": "Sources: web (FineWeb-2), Wikipedia, subtitles, Gheg web text, offensive comments (Shaj), Mozilla Spontaneous Speech (Gheg) transcripts, one hand-written slang sentence per line. Flagged: vulgar swearing only; mild insults and everyday slang (budalla, idiot, gomar, vlla, osht) are not. Exceptions: kopilot (co-pilot), Kurvelesh (a region), Qirjak* (a name), labirint/lavirint. Deliberately not flagged: qi (Gheg 'që'), qift*/qifteli (çift, çifteli), qime (hair), prostitut* (a neutral word)."
}
